#include <iostream>
using namespace std;

int main() {
    setlocale(0, "");
    int sum = 0;
    int number;
    int count = 0;

    cout << "Введите число:" << endl;
    cin >> number;

    while (number != 0) {
        sum += number;
        count++; 

        cout << "Введите число:" << endl;
        cin >> number;
    }

    cout << "Сумма: " << sum << endl;
    cout << "Количество: " << count << endl; 
}
