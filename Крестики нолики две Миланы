        cout << "3. Ник Игрока 2 (сейчас: " << player2Nick << ")\n";
        cout << "4. Символ Игрока 1 (сейчас: " << player1Symbol << ")\n";
        cout << "5. Символ Игрока 2 (сейчас: " << player2Symbol << ")\n";
        cout << "6. Вернуться в главное меню\n";
        cout << "Выберите пункт: ";
        cin >> choice;

        if (choice == 1) {
            cout << "Выберите режим (1 - с компьютером, 2 - для двоих): ";
            cin >> tempMode;
            if (tempMode == 1 || tempMode == 2) {
                gameMode = tempMode;
            }
        }
        else if (choice == 2) {
            cout << "Введите новый ник для Игрока 1 (макс 49 символов): ";
            cin.ignore();
            cin.getline(tempNick, 50);
            for (int i = 0; tempNick[i] != '\0'; i++) {
                player1Nick[i] = tempNick[i];
            }
            player1Nick[49] = '\0';
        }
        else if (choice == 3) {
            cout << "Введите новый ник для Игрока 2 (макс 49 символов): ";
            cin.ignore();
            cin.getline(tempNick, 50);
            for (int i = 0; tempNick[i] != '\0'; i++) {
                player2Nick[i] = tempNick[i];
            }
            player2Nick[49] = '\0';
        }
        else if (choice == 4) {
            cout << "Введите символ для Игрока 1: ";
            cin >> tempSymbol;
            if (tempSymbol != ' ' && tempSymbol != player2Symbol) {
                player1Symbol = tempSymbol;
            }
            else {
                cout << "Некорректный символ!\n";
                cin.get();
                cin.get();
            }
        }
        else if (choice == 5) {
            cout << "Введите символ для Игрока 2: ";
            cin >> tempSymbol;
            if (tempSymbol != ' ' && tempSymbol != player1Symbol) {
                player2Symbol = tempSymbol;
            }
            else {
                cout << "Некорректный символ!\n";
                cin.get();
                cin.get();
            }
        }
        else if (choice == 6) {
            break;
        }
    }
}

int mainMenu() {
    int choice;
    while (1) {
        for (int i = 0; i < 50; i++) cout << "\n";
        cout << "=== КРЕСТИКИ-НОЛИКИ ===\n";
        cout << "1. Начать игру\n";
        cout << "2. Статистика\n";
        cout << "3. Настройки\n";
        cout << "4. Выйти\n";
        cout << "Выберите пункт: ";
        cin >> choice;

        if (choice >= 1 && choice <= 4) {
            return choice;
        }
    }
}

int main() {
    srand(time(0));

    while (1) {
        int choice = mainMenu();

        if (choice == 1) {
            playGame();
        }
        else if (choice == 2) {
            showStats();
        }
        else if (choice == 3) {
            settingsMenu();
        }
        else if (choice == 4) {
            cout << "До свидания!\n";
            break;
        }
    }

    return 0;
}
