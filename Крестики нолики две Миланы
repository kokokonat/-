#include <iostream>
#include <cstdlib>
#include <ctime>
#include <limits>

using namespace std;

char board[3][3];
int gameMode = 1;
char player1Symbol = 'X';
char player2Symbol = 'O';
char player1Color = 1;
char player2Color = 2;
char player1Nick[50] = "Игрок 1";
char player2Nick[50] = "Игрок 2";

int p1Wins = 0, p1Losses = 0, p1Draws = 0;
int p2Wins = 0, p2Losses = 0, p2Draws = 0;
double p1Score = 0, p2Score = 0;

void initBoard() {
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            board[i][j] = '1' + (i * 3 + j);
        }
    }
}

void drawBoard() {
    cout << "\n     ";
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            cout << board[i][j];
            if (j < 2) cout << " | ";
        }
        cout << "\n";
        if (i < 2) cout << "    -----------\n     ";
    }
    cout << "\n";
}

int checkWin(char symbol) {
    for (int i = 0; i < 3; i++) {
        if (board[i][0] == symbol && board[i][1] == symbol && board[i][2] == symbol) return 1;
        if (board[0][i] == symbol && board[1][i] == symbol && board[2][i] == symbol) return 1;
    }
    if (board[0][0] == symbol && board[1][1] == symbol && board[2][2] == symbol) return 1;
    if (board[0][2] == symbol && board[1][1] == symbol && board[2][0] == symbol) return 1;
    return 0;
}

int checkDraw() {
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            if (board[i][j] != player1Symbol && board[i][j] != player2Symbol) {
                return 0;
            }
        }
    }
    return 1;
}

void computerMove() {
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            if (board[i][j] != player1Symbol && board[i][j] != player2Symbol) {
                board[i][j] = player2Symbol;
                return;
            }
        }
    }
}

void updateStats(int winner) {
    if (winner == 1) {
        p1Wins++;
        p1Score += 5.0;
        p2Losses++;
        p2Score -= 6.0;
    }
    else if (winner == 2) {
        p2Wins++;
        p2Score += 5.0;
        p1Losses++;
        p1Score -= 6.0;
    }
    else if (winner == 3) {
        p1Draws++;
        p2Draws++;
        p1Score -= 1.2;
        p2Score -= 1.2;
    }
}
void playGame() {
    initBoard();
    int currentPlayer = 1;
    int winner = 0;
    int move, row, col;

    while (winner == 0) {
        for (int i = 0; i < 50; i++) cout << "\n";

        cout << "=== КРЕСТИКИ-НОЛИКИ ===\n";
        drawBoard();

        if (currentPlayer == 1) {
            cout << player1Nick << " (" << player1Symbol << "), введите номер клетки (1-9): ";
            cin >> move;

            if (cin.fail() || move < 1 || move > 9) {
                cin.clear();
                cin.ignore(1000, '\n');
                cout << "Ошибка! Нажмите Enter...";
                cin.get();
                cin.get();
                continue;
            }

            row = (move - 1) / 3;
            col = (move - 1) % 3;

            if (board[row][col] == player1Symbol || board[row][col] == player2Symbol) {
                cout << "Клетка занята! Нажмите Enter...";
                cin.get();
                cin.get();
                continue;
            }

            board[row][col] = player1Symbol;

            if (checkWin(player1Symbol)) {
                winner = 1;
                break;
            }
            if (checkDraw()) {
                winner = 3;
                break;
            }
            currentPlayer = 2;
        }
        else { 
            if (gameMode == 1) {
                cout << "Ход компьютера (" << player2Symbol << ")...\n";
                computerMove();

                if (checkWin(player2Symbol)) {
                    winner = 2;
                    break;
                }
                if (checkDraw()) {
                    winner = 3;
                    break;
                }
                currentPlayer = 1;
            }
            else {
                cout << player2Nick << " (" << player2Symbol << "), введите номер клетки (1-9): ";
                cin >> move;

                if (cin.fail() || move < 1 || move > 9) {
                    cin.clear();
                    cin.ignore(1000, '\n');
                    cout << "Ошибка! Нажмите Enter...";
                    cin.get();
                    cin.get();
                    continue;
                }

                row = (move - 1) / 3;
                col = (move - 1) % 3;

                if (board[row][col] == player1Symbol || board[row][col] == player2Symbol) {
                    cout << "Клетка занята! Нажмите Enter...";
                    cin.get();
                    cin.get();
                    continue;
                }

                board[row][col] = player2Symbol;

                if (checkWin(player2Symbol)) {
                    winner = 2;
                    break;
                }
                if (checkDraw()) {
                    winner = 3;
                    break;
                }
                currentPlayer = 1;
            }
        }
    }

    for (int i = 0; i < 50; i++) cout << "\n";
    drawBoard();

    if (winner == 1) {
        cout << "ПОБЕДИТЕЛЬ: " << player1Nick << "!\n";
    }
    else if (winner == 2) {
        if (gameMode == 1) {
            cout << "ПОБЕДИТЕЛЬ: Компьютер!\n";
        }
        else {
            cout << "ПОБЕДИТЕЛЬ: " << player2Nick << "!\n";
        }
    }
    else {
        cout << "НИЧЬЯ!\n";
    }

    updateStats(winner);

    cout << "\nНажмите Enter для продолжения...";
    cin.ignore();
    cin.get();
}

void showStats() {
    for (int i = 0; i < 50; i++) cout << "\n";
    cout << "=== СТАТИСТИКА ===\n\n";
    cout << player1Nick << " (" << player1Symbol << "):\n";
    cout << "  Побед: " << p1Wins << "\n";
    cout << "  Поражений: " << p1Losses << "\n";
    cout << "  Ничьих: " << p1Draws << "\n";
    cout << "  Очки: " << p1Score << "\n\n";

    if (gameMode == 1) {
        cout << "Компьютер (" << player2Symbol << "):\n";
    }
    else {
        cout << player2Nick << " (" << player2Symbol << "):\n";
    }
    cout << "  Побед: " << p2Wins << "\n";
    cout << "  Поражений: " << p2Losses << "\n";
    cout << "  Ничьих: " << p2Draws << "\n";
    cout << "  Очки: " << p2Score << "\n\n";

    cout << "Нажмите Enter для возврата...";
    cin.ignore();
    cin.get();
}

void settingsMenu() {
    int choice;
    int tempMode;
    char tempSymbol;
