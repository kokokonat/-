    while (1) {
        for (int i = 0; i < 50; i++) cout << "\n";
        cout << "=== НАСТРОЙКИ ===\n";
        cout << "1. Режим игры (сейчас: " << (gameMode == 1 ? "с компьютером" : "для двоих") << ")\n";
