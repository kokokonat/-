#include <iostream>
using namespace std;

int main() {

    int sum = 0;
    int i = 0;
    int num;

    cin >> num;
    while (num != 0) {
        sum += num;
        i++;
        cin >> num;
    }

    if (i > 0) {
        cout << sum / i << endl;
    }
    else {
        cout << 0 << endl;
    }

    return 0;
}
