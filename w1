#include <iostream>
using namespace std;

int main() {
    setlocale(0, "");
    int sum = 0;
    int number;

    cout << "Введите число:" << endl;
    cin >> number;

    while (number != 0) {
        sum += number;
        cout << "Введите число:" << endl;
        cin >> number;
    }

    cout << "Сумма: " << sum << endl;
}
